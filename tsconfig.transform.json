{
  "extends": "@diplodoc/infra/tsconfig.json",
  "compilerOptions": {
    "lib": ["es2018"],
    "outDir": "build",
    "module": "preserve",
    "declaration": true,
    "isolatedModules": true,
    "noImplicitAny": true,
    "target": "ES2018",
    "moduleResolution": "bundler",
    "rootDir": "./src"
  },
  "include": ["src/**/*"]
}
